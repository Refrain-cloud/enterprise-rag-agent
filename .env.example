# 复制为 .env 后按需修改；仓库不提交 .env。
# 本项目不自动读取 .env，bash 下用：
#   set -a; source .env; set +a

# ---------- 必填 ----------
# 百炼（DashScope）API Key；也接受 OPENAI_API_KEY（二选一）
DASHSCOPE_API_KEY=
# OPENAI_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 模型 ----------
RAG_CHAT_MODEL=qwen-plus
RAG_EMBED_MODEL=text-embedding-v3
RAG_EMBED_DIM=1024
# 扫描件 OCR（构建语料时使用）
RAG_OCR=1
RAG_OCR_MODEL=qwen3-vl-plus
RAG_SEED=42

# ---------- 分块与检索 ----------
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=12
RAG_CANDIDATE_K=40
# 聚合题在没有表格时放宽到的候选数
RAG_AGG_TOP_K=16
# 受限最优命中与可访问最优命中的距离裕度，用于判断是否在问机密内容
RAG_GUARD_DISTANCE_GAP=0.03
# 零命中时用模型改写一次查询再检索
RAG_REWRITE_ON_EMPTY=1
RAG_REWRITE_MAX_TOKENS=80

# ---------- rerank（默认关闭） ----------
RAG_RERANK=0
RAG_RERANK_MODEL=gte-rerank-v2
# 默认只重排已召回的 top-k，不扩大上下文成员
RAG_RERANK_CANDIDATE_K=12
RAG_RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# ---------- 生成 ----------
RAG_MAX_TOKENS=900
RAG_MAX_TOKENS_HEADER=1200
RAG_MAX_TOKENS_CEILING=2400
# 结构化字段重写默认关闭（v5 全量验证会误改多跳题）
RAG_FIELD_RETRY=0

# ---------- 表格 / SQL ----------
RAG_TABLE_TOOL=1
RAG_TABLE_MAX_DOCS=3
RAG_TABLE_MAX_ROWS=200

# ---------- API 并发与超时 ----------
RAG_API_MAX_CONCURRENCY=4
RAG_API_QUEUE_TIMEOUT_S=5
RAG_API_REQUEST_TIMEOUT_S=120

# ---------- 多轮会话（应用层内存存储，重启即清空） ----------
RAG_SESSION_TTL_S=1800
RAG_SESSION_MAX_TURNS=10
RAG_SESSION_MAX_TOKENS=100000
RAG_SESSION_MAX_COST_CNY=0.5
RAG_SESSION_MAX_COUNT=500
RAG_SESSION_HISTORY_TURNS=3
RAG_SESSION_HISTORY_CHARS=1200
RAG_SESSION_ANSWER_CHARS=400
RAG_FOLLOWUP_REWRITE=1
RAG_FOLLOWUP_MAX_TOKENS=80

# ---------- 流式 ----------
RAG_STREAM_INCLUDE_USAGE=1
RAG_STREAM_HEARTBEAT_S=15

# ---------- 计费（元/百万 token，JSON 覆盖默认价目） ----------
# RAG_PRICE_PER_MILLION={"qwen-plus": {"input": 0.8, "output": 2.0}}
